# Zynksec dashboard — environment template.
#
# Copy to .env.local for local dev (.env.local is gitignored by
# Next.js's default).  The compose service injects NEXT_PUBLIC_API_URL
# at runtime so this file is only needed for `pnpm dev` outside compose.

# Base URL of the FastAPI backend.  Must be reachable from the
# browser (NEXT_PUBLIC_* values are inlined into the client bundle),
# so use the host-side URL even when developing inside compose.
NEXT_PUBLIC_API_URL=http://localhost:8000
